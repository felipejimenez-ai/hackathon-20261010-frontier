---
title: Black Box Replica - Architecture (v2, as deployed)
---
flowchart TB
    Client(["Client<br/>POST /msg  Authorization: Bearer token<br/>every terminal node below returns its status + body to the client<br/>D1-D7 = decisions in system-design.md"])

    subgraph RT["RUNTIME - single process on Railway, in-memory state per token"]
        direction TB
        R1{"1 Route resolve<br/>Entrada - D1 order = precedence"}
        R2{"2 Auth<br/>Entrada"}
        R3["3 Body parse<br/>JSON with string m"]
        R4["4 Split on ;<br/>last field = control"]
        R5{"5 Integrity<br/>Integridad - PING exempt - D4 hybrid"}
        R6{"6 Dispatcher<br/>Comandos - case-insensitive"}
        H["7 Handlers - D2 no LLM<br/>PING ALTA CONSULTA DEPOSITO TRANSFER ANULA"]
        Store[("Token Store - Memoria - D3 no DB<br/>accounts, ops, AC-/OP- seq,<br/>annulled flag + undo")]
        Ser["8 Serializer<br/>exact status + body, typo recieved kept"]

        Health["200 /health no auth"]
        NF["404 E404<br/>before auth"]
        E001["401 E001"]
        Reset["200 /__reset<br/>fresh token state"]
        EB["400 E100 bad JSON<br/>400 E102 no m"]
        ES["400 E103 no control<br/>400 E104 empty segment"]
        EI["400 E201 bad format<br/>400 E202 wrong value"]
        ED["400 E301 unknown<br/>400 E302 arity"]
        EH["Errores: E303 amount, E304 same acct,<br/>E401 acct, E506 limit, E507 funds, E402 op"]

        R1 --> R2 --> R3 --> R4 --> R5 --> R6 --> H --> Ser
        H <--> Store

        R1 -.-> Health
        R1 -.-> NF
        R2 -.-> E001
        R2 -.-> Reset
        R3 -.-> EB
        R4 -.-> ES
        R5 -.-> EI
        R6 -.-> ED
        H -.-> EH
    end

    subgraph DATA["DATA - D5 parameters as data, not code"]
        direction TB
        Cfg[/"config.mjs<br/>limit 50000, max amount, error table,<br/>commands/arity, id prefixes, typo,<br/>currency divisor, token whitelist"/]
        Chk[/"Checksum - hybrid<br/>mod-97 model (CONSULTA;AC-####)<br/>+ measured table, else lenient"/]
    end

    subgraph LOOP["OFFLINE LEARNING + CHANGE LOOP - original never called at runtime"]
        direction LR
        Orig(["Original service"])
        Recon["D7 recon / probes<br/>own scripts"]
        Log[("experimentos.jsonl")]
        Diff["D6 Differential oracle<br/>diff = candidate change"]
        Gate{"Gate: 20/20 replay,<br/>checksum 0 mismatches,<br/>no regression"}
        Orig -.->|"probe"| Recon --> Log --> Diff --> Gate
    end

    Client --> R1
    Cfg -.-> R5
    Cfg -.-> H
    Cfg -.-> Ser
    Chk -.-> R5
    Gate -.->|"update value / rule / table"| Cfg
    Gate ==> Deploy["Deploy to Railway<br/>1 instance, healthcheck /health"]
    Deploy ==> R1

    classDef err fill:#fde8e8,stroke:#c0392b,color:#7b1d12
    classDef ok fill:#e8f5e9,stroke:#2e7d32,color:#1b4d1f
    classDef data fill:#fff8e1,stroke:#b8860b,color:#5d4600
    classDef off fill:#eef2ff,stroke:#4a5bb0,color:#1f2a66
    class E001,EB,ES,EI,ED,EH,NF err
    class Health,Reset,Ser,H ok
    class Cfg,Chk,Store data
    class Orig,Recon,Log,Diff,Gate,Deploy off

